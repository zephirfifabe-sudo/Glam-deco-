# Copy this file to .env and fill in real values.
# Never commit .env or .env.production - see .gitignore.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# DIRECT_URL is used by Prisma Migrate (no pooling); DATABASE_URL is used
# by the app at runtime (can point at a connection pooler in production).
DATABASE_URL="postgresql://glamdeco:glamdeco@localhost:5432/glamdeco?schema=public"
DIRECT_URL="postgresql://glamdeco:glamdeco@localhost:5432/glamdeco?schema=public"

# --- Redis (rate limiting, locks, cache) ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js ---
# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- MFA (TOTP secret encryption at rest) ---
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY="replace-with-a-random-32-byte-key"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

# --- Object storage (S3-compatible; MinIO locally) ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="eu-central-1"
STORAGE_ACCESS_KEY="glamdeco"
STORAGE_SECRET_KEY="glamdeco-dev-secret"
STORAGE_BUCKET_PRIVATE="glamdeco-private"
STORAGE_BUCKET_PUBLIC="glamdeco-public"
STORAGE_FORCE_PATH_STYLE=true

# --- Email (transactional) ---
# Development: set SMTP_HOST/SMTP_PORT to send through the local Mailhog
# container (docker-compose.yml) - view captured mail at localhost:8025.
# Production: leave SMTP_HOST unset and set EMAIL_API_KEY (Resend) instead.
SMTP_HOST="localhost"
SMTP_PORT=1025
EMAIL_API_KEY="replace-with-provider-api-key"
EMAIL_FROM="Glam Déco <no-reply@glamdeco.example>"

# --- Feature flags (see ROADMAP.md) ---
FEATURE_EVENT_PLANNER=false
FEATURE_RENTAL=false
