// Phase 2 (Foundation) scope: Identity & access + Catalog base entities.
// See DATABASE.md for the full target model - later phases add Inventory,
// Cart/Orders/Payments, Shipping, Returns, Buyback, Inspection, Payouts,
// Fraud, Reviews, Notifications, Audit as their own migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Enums ---

enum Role {
  CUSTOMER
  SUPPORT
  INSPECTOR
  WAREHOUSE
  FINANCE
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum VerificationTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProductCondition {
  NEW
  USED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Physical-unit condition (DATABASE.md §2) - distinct from
// ProductCondition, which is the catalog-level NEW/USED split. Every
// InventoryItem carries one of these regardless of its Product's
// top-level condition.
enum Condition {
  NEW
  LIKE_NEW
  EXCELLENT
  GOOD
  FAIR
  DAMAGED
  INCOMPLETE
  UNUSABLE
  PENDING_INSPECTION
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  RETURNED
  INSPECTION
  REPAIR
  DAMAGED
  LOST
  DISPOSED
}

enum InventoryAcquisitionSource {
  PURCHASE_ORDER
  BUYBACK
}

// Append-only ledger entry types (DATABASE.md §11) - every status
// change on an InventoryItem writes one of these, so stock state is
// always reconstructable from history, never only from the mutable
// `status` column.
enum InventoryMovementType {
  PURCHASE_RECEIVED
  RESERVED
  RELEASED
  SOLD
  RETURNED
  BUYBACK_RECEIVED
  INSPECTION_ACCEPTED
  INSPECTION_REJECTED
  ADJUSTMENT
  DAMAGED
  LOST
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

// --- Identity & access ---

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  name            String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles              UserRoleAssignment[]
  sessions           Session[]
  mfaSecret          MfaSecret?
  verificationTokens VerificationToken[]
  addresses          Address[]
  consents           Consent[]
  inventoryMovements InventoryMovement[]
  cart               Cart?
  orders             Order[]

  @@index([status])
}

// Our own revocation ledger, deliberately not the Auth.js adapter's
// default Session shape - see ADR-003 (JWT-plus-ledger design). The
// jti is embedded in the signed JWT at sign-in; every authenticated
// request looks this row up to confirm the session hasn't been revoked.
model Session {
  id        String    @id @default(cuid())
  jti       String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// TOTP secret, encrypted at rest with MFA_ENCRYPTION_KEY (see .env.example).
// Recovery codes are stored as a hashed array, single-use.
model MfaSecret {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedSecret    String
  recoveryCodeHashes String[]
  createdAt          DateTime  @default(now())
  confirmedAt        DateTime?
}

// Single-use, short-lived tokens for email verification and password
// reset. Only a hash of the token is stored - the raw token exists only
// in the emailed link and is never persisted (brief SECURITY.md §1).
model VerificationToken {
  id         String                   @id @default(cuid())
  userId     String
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String                   @unique
  purpose    VerificationTokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                 @default(now())

  @@index([userId, purpose])
}

model UserRoleAssignment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role

  @@unique([userId, role])
  @@index([role])
}

// Permission keys are strings ("order.read", "buyback.inspect", ...) so
// new permissions can be introduced without a schema migration; the
// role -> permission mapping is admin-editable data, not hardcoded
// conditionals (see SECURITY.md §2, PermissionService).
model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model Address {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AddressType
  fullName   String
  line1      String
  line2      String?
  postalCode String
  city       String
  country    String // ISO 3166-1 alpha-2, "BE" at launch
  phone      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
}

// GDPR consent records - explicit, timestamped, revocable (brief §78).
model Consent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // e.g. "marketing_email", "analytics_cookies"
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  source    String // e.g. "signup_form", "cookie_banner"

  @@index([userId])
}

// --- Catalog ---

model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  parentId String?
  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToParent")
  products Product[]

  @@index([parentId])
}

model EventType {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Tag {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id                             String           @id @default(cuid())
  slug                           String           @unique
  title                          String
  description                    String
  basePriceMinor                 Int
  currency                       String           @default("EUR")
  condition                      ProductCondition
  status                         ProductStatus    @default(DRAFT)
  categoryId                     String
  category                       Category         @relation(fields: [categoryId], references: [id])
  eventTypes                     EventType[]
  tags                           Tag[]
  personalizationRequired        Boolean          @default(false)
  // Buyback eligibility defaults to false for anything personalizable -
  // see BUYBACK.md §3. An admin flips this per product for exceptions.
  personalizationBuybackEligible Boolean          @default(false)
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt

  variants ProductVariant[]
  images   ProductImage[]

  @@index([categoryId])
  @@index([createdAt])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String   @unique
  name       String // e.g. "Blanc / 2m"
  priceMinor Int? // overrides Product.basePriceMinor when set
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  inventoryItems InventoryItem[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId])
}

// Belongs to a Product (marketing photos, shared across NEW-condition
// units) OR to a specific InventoryItem (a used unit's own real
// photos) - never both, never neither. Prisma has no portable
// declarative XOR constraint, so this is enforced with a CHECK
// constraint added by hand in the migration SQL (see
// prisma/migrations/*_add_inventory) - DATABASE.md §4/§6.
model ProductImage {
  id              String         @id @default(cuid())
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  url             String
  alt             String
  position        Int            @default(0)
  createdAt       DateTime       @default(now())

  @@index([productId])
  @@index([inventoryItemId])
}

// --- Inventory ---

model InventoryLocation {
  id        String          @id @default(cuid())
  name      String
  code      String          @unique
  items     InventoryItem[]
  createdAt DateTime        @default(now())
}

// One physical, serialized unit - never a bare quantity counter
// (DATABASE.md §10/§11). A Product/ProductVariant can have zero to
// many of these; only an InventoryItem is ever actually allocated to
// an order.
model InventoryItem {
  id                String                     @id @default(cuid())
  productVariantId  String
  productVariant    ProductVariant             @relation(fields: [productVariantId], references: [id])
  serial            String                     @unique
  condition         Condition
  status            InventoryStatus            @default(AVAILABLE)
  locationId        String
  location          InventoryLocation          @relation(fields: [locationId], references: [id])
  acquisitionSource InventoryAcquisitionSource @default(PURCHASE_ORDER)
  costBasisMinor    Int?
  // originBuybackItemId intentionally omitted for now - BuybackItem
  // doesn't exist until Phase 6. Add the FK then, additively.
  conditionNotes    String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  images    ProductImage[]
  movements InventoryMovement[]
  orderItem OrderItem?

  @@index([status])
  @@index([productVariantId])
}

// Append-only - never updated or deleted, only inserted (DATABASE.md
// §11/§12). This is the audit trail an InventoryItem.status change
// must always be accompanied by; reference{Type,Id} is a deliberately
// loose polymorphic pointer (Order/BuybackRequest/Adjustment) since
// those targets don't all exist yet as FKs can enforce.
model InventoryMovement {
  id            String                @id @default(cuid())
  itemId        String
  item          InventoryItem         @relation(fields: [itemId], references: [id])
  type          InventoryMovementType
  fromStatus    InventoryStatus?
  toStatus      InventoryStatus
  actorId       String?
  actor         User?                 @relation(fields: [actorId], references: [id])
  referenceType String?
  referenceId   String?
  notes         String?
  createdAt     DateTime              @default(now())

  @@index([itemId])
  @@index([createdAt])
}

// --- Cart & Orders ---

// One cart per signed-in user (guest/session-based carts are a Phase
// 5+ extension noted in DATABASE.md but not built here - userId is
// required for this phase's scope). CartItem never stores a price -
// the cart is not a source of truth (brief §27); checkout always
// recomputes from the current ProductVariant/Product.
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id               String         @id @default(cuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int            @default(1)
  createdAt        DateTime       @default(now())

  @@unique([cartId, productVariantId])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  status            OrderStatus @default(PENDING_PAYMENT)
  subtotalMinor     Int
  taxMinor          Int
  shippingMinor     Int
  totalMinor        Int
  currency          String      @default("EUR")
  // No address flow yet (brief scope for this phase is payment, not
  // shipping) - Shipping/Address-on-order lands with the Shipping
  // module. Left nullable so that migration is additive, not breaking.
  shippingAddressId String?
  billingAddressId  String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  // The specific physical unit allocated to this line (DATABASE.md
  // §"Orders & Payments") - set at checkout time by
  // InventoryService.reserveOneUnitInTx, inside the same transaction
  // that creates this row.
  inventoryItemId  String         @unique
  inventoryItem    InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  unitPriceMinor   Int
  quantity         Int            @default(1)
  createdAt        DateTime       @default(now())

  @@index([orderId])
}

model Payment {
  id                        String          @id @default(cuid())
  orderId                   String
  order                     Order           @relation(fields: [orderId], references: [id])
  provider                  PaymentProvider @default(STRIPE)
  providerPaymentIntentId   String?         @unique
  providerCheckoutSessionId String?         @unique
  status                    PaymentStatus   @default(PENDING)
  amountMinor               Int
  currency                  String          @default("EUR")
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  events PaymentEvent[]

  @@index([orderId])
  @@index([status])
}

// Idempotency ledger for Stripe webhooks (DATABASE.md §"Orders &
// Payments", brief §24): the unique (provider, eventId) constraint is
// what makes a duplicate webhook delivery a no-op. payloadHash (not
// the raw payload) is stored - enough to detect a genuine content
// mismatch under a replayed id without holding onto full payment
// payloads indefinitely (data minimization, brief §109).
model PaymentEvent {
  id          String          @id @default(cuid())
  paymentId   String
  payment     Payment         @relation(fields: [paymentId], references: [id])
  provider    PaymentProvider
  eventId     String
  type        String
  payloadHash String
  receivedAt  DateTime        @default(now())
  appliedAt   DateTime?

  @@unique([provider, eventId])
  @@index([paymentId])
}
